{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for all belfry-project repositories",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Brussels",
  "schedule": [
    "before 7am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Keep GitHub Actions updates together and pin them to a commit",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "pinDigests": true
    },
    {
      "description": "Python versions in workflows are chosen deliberately to match the images; do not bump automatically",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Pin CentOS base images by digest; Renovate proposes digest refreshes on the regular schedule. Moving to a new CentOS Stream release stays a manual change.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/centos/centos"
      ],
      "pinDigests": true,
      "groupName": "CentOS base images"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions in Makefiles, annotated with a '# renovate: datasource=... depName=...' comment on the line above",
      "managerFilePatterns": [
        "/(^|/)Makefile$/",
        "/\\.mk$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n[A-Za-z0-9_]+ \\?= (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Versions in YAML and Jinja templates, annotated with a '# renovate: datasource=... depName=...' comment on the line above",
      "managerFilePatterns": [
        "/\\.ya?ml(\\.j2)?$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s*[A-Za-z0-9_]+: [\"']?(?<currentValue>[^\"'\\s:]+)[\"']?\\n",
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\n\\s*image: [\"']?[^\"'\\s]+?:(?<currentValue>[^\"'\\s@:]+)[\"']?\\n"
      ]
    }
  ]
}
